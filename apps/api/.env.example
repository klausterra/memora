# Server
PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,https://memora.hipercube.ia.br,https://memora-1f1.pages.dev

# Firebase (Hipercube)
FIREBASE_PROJECT_ID=hipercube-dev-train
# Optional: path to service account JSON, or leave empty to use ADC / Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=

# Dev only — never enable in production
# DEV_AUTH_BYPASS=1

# OpenAI (optional — without it, chat uses a local stub)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite path (created automatically)
DATABASE_PATH=./data/memora.sqlite
