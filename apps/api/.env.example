# Server
PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://memora.hipercube.ia.br,https://memora-1f1.pages.dev

# Firebase (Hipercube Auth)
FIREBASE_PROJECT_ID=hipercube-dev-train

# Vertex AI (projeto GCP Hipercube)
AI_BACKEND=vertex
VERTEX_PROJECT=hipercube-500101
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# SQLite (local only — omit DATABASE_URL)
DATABASE_PATH=./data/memora.sqlite

# Postgres (produção Cloud SQL). Quando definido, ignora DATABASE_PATH.
# DATABASE_URL=postgresql://memora:SENHA@/memora?host=/cloudsql/hipercube-500101:us-central1:memora-pg
